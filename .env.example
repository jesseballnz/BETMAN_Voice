BETMAN_VOICE_ENV=production
BETMAN_VOICE_PORT=8088
BETMAN_VOICE_INTERNAL_PORT=18088
BETMAN_VOICE_PUBLIC_BASE_URL=https://170.64.201.92:8088
BETMAN_VOICE_SECRET_KEY=change-this-long-random-secret
BETMAN_VOICE_ADMIN_EMAIL=betman
BETMAN_VOICE_ADMIN_PASSWORD=betman1234
BETMAN_VOICE_DEFAULT_TENANT=betman
BETMAN_VOICE_DEFAULT_API_KEY=change-this-api-key

POSTGRES_DB=betman_voice
POSTGRES_USER=betman_voice
POSTGRES_PASSWORD=change-this-postgres-password
BETMAN_VOICE_DATABASE_URL=postgresql+psycopg://betman_voice:change-this-postgres-password@postgres:5432/betman_voice

BETMAN_VOICE_STORAGE_BACKEND=local
BETMAN_VOICE_LOCAL_STORAGE_DIR=/var/lib/betman-voice/audio
BETMAN_VOICE_SPACES_BUCKET=
BETMAN_VOICE_SPACES_REGION=sgp1
BETMAN_VOICE_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
BETMAN_VOICE_SPACES_ACCESS_KEY_ID=
BETMAN_VOICE_SPACES_SECRET_ACCESS_KEY=
BETMAN_VOICE_SPACES_PUBLIC_BASE_URL=

BETMAN_VOICE_MODEL_BACKEND=voicebox
BETMAN_VOICE_MODEL_NAME=qwen3-tts
BETMAN_VOICE_MODEL_DIR=/models
BETMAN_VOICE_PIPER_MODEL_PATH=/models/piper/en_US-amy-medium.onnx
BETMAN_VOICE_PIPER_CONFIG_PATH=/models/piper/en_US-amy-medium.onnx.json
BETMAN_VOICE_MAX_WORKERS=1
BETMAN_VOICE_JOB_POLL_SECONDS=2
BETMAN_VOICE_ELEVENLABS_POLL_SECONDS=0
BETMAN_VOICE_TRAINING_COMMAND=
BETMAN_VOICE_AUDIO_FORMAT=wav
BETMAN_VOICE_ALLOW_SYNTHETIC_FALLBACK=false
BETMAN_VOICE_REQUEST_TIMEOUT_SECONDS=600
BETMAN_VOICE_SYNC_THROUGH_WORKER=true
BETMAN_VOICE_QWEN_PROFILES_DIR=/var/lib/betman-voice/qwen-profiles
BETMAN_VOICE_QWEN_SEED=42
BETMAN_VOICE_QWEN_LANGUAGE=English
BETMAN_VOICE_QWEN_MAX_NEW_TOKENS=512
BETMAN_VOICE_QWEN_NUM_THREADS=8
BETMAN_VOICE_QWEN_PRELOAD=true
